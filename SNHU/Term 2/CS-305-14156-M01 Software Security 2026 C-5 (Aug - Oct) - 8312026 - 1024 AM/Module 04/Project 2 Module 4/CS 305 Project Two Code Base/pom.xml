<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  SECURITY REFACTOR (A06:2021 - Vulnerable and Outdated Components)
	  The skeleton pinned spring-boot-starter-parent 2.2.4.RELEASE (released Jan 2020,
	  end-of-life). That single line inherited dozens of published CVEs through Spring
	  Framework, Tomcat, Jackson and SnakeYAML. Upgraded to the current 4.1.x GA line, which
	  is actively patched and enforces TLS defaults we rely on below.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.snhu</groupId>
	<artifactId>ssl-server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ssl-server</name>
	<description>Artemis Financial secure checksum service (CS-305 Project Two)</description>

	<properties>
		<!-- Java 8 reached end of public updates; build on a supported LTS. -->
		<java.version>21</java.version>
		<!--
		  CVSS score at which dependency-check fails the build.
		  11 = report only (nothing scores above 10), which is what we want while the
		  report screenshots are being captured. Set to 7 in a CI pipeline so that any
		  High/Critical finding blocks the merge.
		-->
		<dependency.check.failOnCVSS>11</dependency.check.failOnCVSS>
		<!-- Overridden on the command line; empty default keeps the POM resolvable. -->
		<nvd.api.key></nvd.api.key>
		<!--
		  Pin the embedded servlet container ahead of the version Boot 4.1.1 manages
		  (11.0.24). Dependency-check flagged 11 CVEs in that build, four of them
		  Critical (CVE-2026-65637, CVE-2026-65905, CVE-2026-65182, CVE-2026-68525).
		  This is the transitive-dependency override the SCA scan drove us to.
		-->
		<tomcat.version>11.0.25</tomcat.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-rest</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
		  Added so the checksum endpoint can be locked down with real HTTP security
		  headers (HSTS, CSP, X-Content-Type-Options) instead of hand-rolled filters.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Spring Boot 4 split MockMvc auto-configuration out of spring-boot-test-autoconfigure. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
			  OWASP Dependency-Check (software composition analysis).
			  Upgraded from 5.3.0: that version reads the retired NVD 1.0 data feeds and
			  can no longer refresh its database at all. 12.x uses the NVD 2.0 REST API.
			  Bound to `verify` so a plain `mvn compile` stays fast.
			-->
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>12.1.0</version>
				<configuration>
					<!-- Free key from https://nvd.nist.gov/developers/request-an-api-key
					     Pass with -Dnvd.api.key=... ; without it the NVD throttles hard. -->
					<nvdApiKey>${nvd.api.key}</nvdApiKey>
					<failBuildOnCVSS>${dependency.check.failOnCVSS}</failBuildOnCVSS>
					<!-- Sonatype OSS Index now returns HTTP 401 without an account token.
					     Left off so the scan runs from the NVD data alone; re-enable with
					     credentials in CI for a second opinion on each dependency. -->
					<ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
					<suppressionFiles>
						<suppressionFile>owasp-suppression.xml</suppressionFile>
					</suppressionFiles>
					<formats>
						<format>HTML</format>
						<format>JSON</format>
					</formats>
				</configuration>
				<executions>
					<execution>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
